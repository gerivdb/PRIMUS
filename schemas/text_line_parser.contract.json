{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "text_line_parser.contract",
  "description": "Contrat d'interface de la primitive text_line_parser (PRIMUS)",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "Contenu texte brut à parser"
        },
        "comment_char": {
          "type": "string",
          "description": "Caractère indiquant un commentaire (défaut '#')",
          "default": "#"
        },
        "strip": {
          "type": "boolean",
          "description": "Supprimer les espaces en début/fin de ligne (défaut true)",
          "default": true
        }
      },
      "required": ["content"],
      "additionalProperties": false
    },
    "output": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Liste des lignes non vides et non commentées"
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Liste des erreurs (vide si succès)"
    },
    "side_effects": {
      "type": "boolean",
      "const": false,
      "description": "Aucun effet de bord"
    },
    "stdlib_only": {
      "type": "boolean",
      "const": true,
      "description": "Stdlib uniquement, aucune dépendance externe"
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
